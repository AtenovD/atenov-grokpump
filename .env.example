BOT_TOKEN=123456:your-telegram-bot-token
ADMIN_IDS=123456789
DB_PATH=pumpguard.db

# Grok (xAI) — used only for the 4 screening agents, never to place trades.
GROK_API_KEY=xai-your-key-here
GROK_BASE_URL=https://api.x.ai/v1/chat/completions
GROK_FAST_MODEL=grok-4-fast
GROK_CHECKER_MODEL=grok-4
GROK_TIMEOUT_SECONDS=20
GROK_MAX_RETRIES=3

# New-launch feed (PumpPortal's public pump.fun WebSocket).
DATA_WS_URL=wss://pumpportal.fun/api/data
MIN_LAUNCH_AGE_SECONDS=60
MIN_UNIQUE_BUYERS=5

# Risk manager
MAX_SOL_PER_TRADE=0.5
DAILY_LOSS_LIMIT_SOL=2.0
MAX_TRADES_PER_DAY=10
MAX_OPEN_POSITIONS=5
STOP_LOSS_PCT=35

# Reputation book
RUG_LOSS_PCT=60
BLOCK_CREATOR_AFTER_RUGS=1
FORGET_CREATORS_AFTER_DAYS=90

# Optional: channel/group the bot posts every passing signal to
ALERT_CHAT_ID=
